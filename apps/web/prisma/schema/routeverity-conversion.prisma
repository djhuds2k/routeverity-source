model RouteVerityConversionKey {
  id          String   @id
  projectId   String
  name        String   @db.VarChar(60)
  tokenHash   String   @unique @db.Char(64)
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@index([projectId, revokedAt])
}

model RouteVerityConversionGoal {
  id         String   @id
  projectId  String
  campaignId String
  event      String   @db.VarChar(64)
  name       String   @db.VarChar(120)
  currency   String   @db.VarChar(3)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([projectId, campaignId, event])
  @@index([projectId, enabled])
}

model RouteVerityConversion {
  id                String   @id
  projectId         String
  campaignId        String
  goalId            String
  clickId           String   @db.VarChar(64)
  event             String   @db.VarChar(64)
  orderId           String   @db.VarChar(120)
  orderHash         String   @db.Char(64)
  customerReference String?  @db.VarChar(120)
  revenue           Decimal  @db.Decimal(18, 3)
  currency          String   @db.VarChar(3)
  occurredAt        DateTime
  receivedAt        DateTime @default(now())
  metadata          Json
  payloadHash       String   @db.Char(64)
  attributionPolicy String   @db.VarChar(40)

  @@unique([projectId, goalId, orderHash])
  @@index([projectId, occurredAt, id])
  @@index([projectId, clickId])
  @@index([projectId, receivedAt, id])
}

model RouteVerityConversionReceipt {
  id           String @id
  projectId    String
  keyHash      String @db.Char(64)
  conversionId String
  payloadHash  String @db.Char(64)

  @@unique([projectId, keyHash])
  @@index([projectId, conversionId])
}

enum RouteVerityMerchantStatus {
  PENDING
  ATTRIBUTED
  UNATTRIBUTED
}

model RouteVerityMerchantSubmission {
  id              String @id
  projectId       String
  campaignId      String
  goalId          String
  credentialId    String
  event           String @db.VarChar(64)
  orderId         String @db.VarChar(120)
  orderHash       String @db.Char(64)
  revenue         Decimal @db.Decimal(18, 3)
  currency        String @db.VarChar(3)
  occurredAt      DateTime
  receivedAt      DateTime @default(now())
  gclidHash       String? @db.Char(64)
  payloadHash     String @db.Char(64)
  status          RouteVerityMerchantStatus
  reason          String @db.VarChar(40)
  conversionId    String?
  reconcileUntil  DateTime
  nextAttemptAt   DateTime
  attempts        Int @default(0)

  @@unique([projectId, goalId, orderHash])
  @@index([projectId, occurredAt, id])
  @@index([projectId, receivedAt, id])
  @@index([receivedAt, id])
  @@index([status, nextAttemptAt, id])
}

model RouteVerityMerchantReceipt {
  id           String @id
  projectId    String
  keyHash      String @db.Char(64)
  submissionId String
  payloadHash  String @db.Char(64)

  @@unique([projectId, keyHash])
  @@index([projectId, submissionId])
}
