# RouteVerity local baseline only. Not a production configuration.
# Generate apps/web/.env.local from the repository root:
# node scripts/local-routeverity.mjs setup
# Never paste real service credentials here or commit .env.local.

DATABASE_URL=mysql://routeverity:GENERATED_BY_SETUP@127.0.0.1:13306/routeverity
NEXTAUTH_URL=http://localhost:8888
NEXTAUTH_SECRET=GENERATED_BY_SETUP
EMAIL_SERVER=smtp://127.0.0.1:11025
EMAIL_FROM=RouteVerity Local <noreply@routeverity.test>
UPSTASH_REDIS_REST_URL=http://127.0.0.1:18079
UPSTASH_REDIS_REST_TOKEN=GENERATED_BY_SETUP

# Hosted MySQL CA, supplied privately as a multiline PEM environment value.
# Leave unset for the isolated local database. Never put service secrets here.
# ROUTEVERITY_DATABASE_CA=

# Future local SQL adapter must use the SDK's { url } option, not { host }.
# This is not wired into the upstream application's SQL clients by setup.
PLANETSCALE_DATABASE_URL=http://routeverity:GENERATED_BY_SETUP@127.0.0.1:13900/routeverity

# Compose-only local MySQL initialization credentials.
# Keep stable once dedicated MySQL storage has been initialized.
ROUTEVERITY_MYSQL_PASSWORD=GENERATED_BY_SETUP
ROUTEVERITY_MYSQL_ROOT_PASSWORD=GENERATED_BY_SETUP
